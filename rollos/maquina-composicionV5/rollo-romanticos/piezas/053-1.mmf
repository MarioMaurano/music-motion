", "measure": 1, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "You are my glorious rose.", "measure": 1, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "Andante moderato", "measure": 1, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "cresc.", "measure": 9, "beatPos": 1, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "dim.", "measure": 13, "beatPos": 2, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "rit.", "measure": 14, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "a tempo", "measure": 15, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "cresc.", "measure": 19, "beatPos": 1, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "cresc.", "measure": 28, "beatPos": 1.5, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "poco string.", "measure": 30, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "dim.", "measure": 35, "beatPos": 1, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "dim.", "measure": 38, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "poco rit.", "measure": 38, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "Tempo I ma poco tranquillo", "measure": 40, "beatPos": 0, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "morendo", "measure": 44, "beatPos": 1, "channel": 0, "scope": [0, 1], "visible": true, "yOffset": 0, "fontSize": 15}, {"text": "dim.", "measure": 2, "beatPos": 1, "channel": 2, "s