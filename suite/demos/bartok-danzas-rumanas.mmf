    "composer": "Béla Bartók",
    "composer_dates": "1881–1945",
    "work_title": "Romanian Folk Dances (Román népi táncok)",
    "catalog": "Sz. 56 / BB 68",
    "year_composed": "1915",
    "genre": "Piano suite (folk-dance collection)",
    "period": "Modern",
    "style_notes": "Bartók weaves authentic Transylvanian folk scales and asymmetric rhythms into a tightly crafted piano suite, breathing with the raw, unsentimental energy of village dance rather than Romantic salon idiom.",
    "movements": [
      {
        "number": 1,
        "title": "Stick Dance (Jocul cu bâtă)",
        "italian_marking": "Moderato",
        "bpm_ref": 100,
        "key": "A minor — dictado por Mario 2026-08-04 (la armadura escrita es otra cosa)",
        "character": "A stern, stamping dance in Dorian-inflected A minor, driven by dotted rhythms that evoke the percussive impact of a stick dance.",
        "duration_sec": 60.00220800520834,
        "tonal_center": {
          "key": "A",
          "alt": "n",
          "mode": 1
        }
      },
      {
        "number": 2,
        "title": "Waistband Dance (Brâul)",
        "italian_marking": "Allegro",
        "bpm_ref": 144,
        "key": "A minor — dictado por Mario 2026-08-04 (la armadura escrita es otra cosa)",
        "character": "A swift, light-footed reel in 2/4 with a bright, pentatonic-tinged melody that spins forward with irresistible momentum.",
        "duration_sec": 27.8516125,
        "tonal_center": {
          "key": "A",
          "alt": "n",
          "mode": 1
        }
      },
      {
        "number": 3,
        "title": "Pe loc (In One Spot)",
        "italian_marking": "Andante",
        "bpm_ref": 76,
        "key": "B minor — dictado por Mario 2026-08-04 (la armadura escrita es otra cosa)",
        "character": "A measured, almost solemn dance with a modal, static quality — the feet barely move, yet there is an inner tension beneath the stillness.",
        "duration_sec": 44.302729953124995,
        "tonal_center": {
          "key": "B",
          "alt": "n",
          "mode": 1
        }
      },
      {
        "number": 4,
        "title": "Dance of Butschum (Buciumeana)",
        "italian_marking": "Moderato",
        "bpm_ref": 100,
        "key": "A minor — dictado por Mario 2026-08-04 (la armadura escrita es otra cosa)",
        "character": "A lyrical, gently melancholic Rubato-inflected dance in 3/4, recalling the long-breathed song of the alpine horn.",
        "duration_sec": 34.815630557291676,
        "tonal_center": {
          "key": "A",
          "alt": "n",
          "mode": 1
        }
      },
      {
        "number": 5,
        "title": "Romanian Polka (Poarga Românească)",
        "italian_marking": "Allegro",
        "bpm_ref": 150,
        "key": "B minor — dictado por Mario 2026-08-04 (la armadura escrita es otra cosa)",
        "character": "A headlong polka with syncopated accents and off-beat sforzandi that give it a boisterous, almost rough village energy.",
        "duration_sec": 30.265965208333316,
        "tonal_center": {
          "key": "B",
          "alt": "n",
          "mode": 1
        }
      },
      {
        "number": 6,
        "title": "Lively Dance (Mărunțel)",
        "italian_marking": "Allegretto — Più allegro",
        "bpm_ref": 152,
        "key": "B minor (desde el compás 182: A major) — dictado por Mario 2026-08-04",
        "character": "A two-part finale that begins sprightly and then accelerates to a breathless close, capping the suite with exhilarating, unstoppable drive.",
