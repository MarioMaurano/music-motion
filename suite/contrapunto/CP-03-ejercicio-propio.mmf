   "measure": 1,
   "id": 1792860006001,
   "text": "Compases 1–4, pregunta: por grados, con un solo salto; queda abierta, en un grado que no sea la tónica."
  },
  {
   "beat": 1,
   "channel": 0,
   "scope": "channel",
   "fontSize": 14,
   "offsetX": 12,
   "offsetY": -30,
   "measure": 1,
   "id": 1792860006002,
   "text": "Compases 5–8, respuesta: la misma regla; puede aterrizar en otro grado. Compases 9–10: cadencia a la tónica, por grado."
  }
 ],
